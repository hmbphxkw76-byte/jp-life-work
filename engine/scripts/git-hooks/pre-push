#!/usr/bin/env bash
# jp-life-work 分支命名守卫（pre-push）。
# 源文件由 engine/scripts/branch_naming.py install 安装；修改请改 engine/scripts/git-hooks/pre-push 后重装。
# 校验失败（退出码 1）即禁止推送。规范：task/<slug>-<sid>，sid=会话标识前 8 位。
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
here="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$root/engine/scripts/branch_naming.py" ]; then
  script="$root/engine/scripts/branch_naming.py"
else
  script="$here/branch_naming.py"
fi
if [ ! -f "$script" ]; then
  echo "[branch-naming] 未找到校验脚本（engine/scripts/branch_naming.py 或 hooks 副本），已禁止推送。" >&2
  exit 1
fi

py=""
for candidate in "${BRANCH_NAMING_PY:-}" python python3; do
  if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
    py="$candidate"
    break
  fi
done
if [ -z "$py" ]; then
  echo "[branch-naming] 未找到 python / python3，已禁止推送（可用 BRANCH_NAMING_PY 指定）。" >&2
  exit 1
fi

exec "$py" "$script" hook pre-push

          "insert_before": "## 九、版本记录",
          "categories_include": [],
          "tags_include": []
        }
      ]
    },
    {
      "topic": "financial-markets",
      "targets": [
        {
          "path": "../dubai/apartment/prompts/business-config.md",
          "format": "digest",
          "section_title": "## 词汇速览（词汇库自动同步）",
          "insert_before": "## 十三、版本记录",
